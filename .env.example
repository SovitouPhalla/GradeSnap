# Frontend (Vite) — safe to expose in the browser bundle.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Client-side throttling for the Gemini-backed scan/grade call (not secret —
# just tuning knobs). Verify current free-tier limits at
# https://ai.google.dev/gemini-api/docs/rate-limits before relying on these.
VITE_GEMINI_DAILY_LIMIT=1400
VITE_GEMINI_MIN_INTERVAL_MS=4500

# Supabase Edge Function secret — set with:
#   supabase secrets set --env-file supabase/.env
# Never expose this to the client.
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the default Gemini model (defaults to gemini-flash-latest).
# GEMINI_MODEL=gemini-flash-latest
